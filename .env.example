# Local development settings, read by the Go commands from the repo root.
ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-opus-5-5

DATABASE_URL=postgres://postgres:postgres@localhost:5433/doc_review

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=documents

PORT=8787
# Set to true behind HTTPS (Terraform sets it on Cloud Run).
COOKIE_SECURE=false

# Written by `make agent-setup`.
AGENT_ID=
ENVIRONMENT_ID=
