# GENERATED by tools/wt for worktree environment "${WT_SLUG}" — do not edit by hand.
#
# Started detached over a Unix socket (never process-compose's default TCP port, 8080, which could
# collide with something else on this machine).

version: "0.5"

log_level: info
log_location: ${WT_STATE}/logs/process-compose.log

processes:
  # The API is built to explicit binaries and exec'd, rather than run under `go run`. `go run` spawns
  # the compiled binary as a child and does not forward SIGTERM to it, which would leave an orphaned
  # server holding this environment's port after `wt down`. Migrations run before every start, so a
  # restart after a commit (the post-commit hook) applies a migration the commit added.
  api:
    command: 'go build -o "${WT_STATE}/bin/" ./cmd/api ./cmd/migrate && "${WT_STATE}/bin/migrate" && exec "${WT_STATE}/bin/api"'
    working_dir: ${WT_PATH}/go
    environment:
      - "ENV_FILE=${WT_STATE}/app.env"
      - "PORT=${WT_API_PORT}"
    availability:
      restart: "no"
    shutdown:
      signal: 15
      timeout_seconds: 15
    log_location: ${WT_STATE}/logs/api.log

  # Vite reads WEB_PORT for itself and API_PORT for its /api proxy (ts/apps/web/vite.config.ts).
  web:
    command: pnpm dev
    working_dir: ${WT_PATH}/ts
    environment:
      - "WEB_PORT=${WT_WEB_PORT}"
      - "API_PORT=${WT_API_PORT}"
    availability:
      restart: "no"
    shutdown:
      signal: 15
      timeout_seconds: 10
    log_location: ${WT_STATE}/logs/web.log
