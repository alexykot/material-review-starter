# Local settings for tools/wt. Optional: every value has a default.
#
#   mkdir -p ~/.material-review && cp tools/wt/wt.env.example ~/.material-review/wt.env

# Ref new worktrees branch from and `wt rebase` rebases onto. Defaults to origin/main.
# WT_BASE_REF=origin/main

# Where environment state (rendered config, logs, sockets, binaries) is kept. Defaults to
# ~/.material-review/worktrees. Exporting it in the environment (MR_WT_HOME=/tmp/x wt list) overrides
# whatever is set here, so a test can point the tool at a throwaway directory without touching real
# environments.
# MR_WT_HOME=

# The env file every environment's app.env is derived from. Defaults to the primary checkout's .env.
# MR_WT_SOURCE_ENV=
